{
  "name": "pos",
  "version": "2.0.0",
  "description": "Universal Multi-Business ERP, Inventory & Super Mart POS System (MERN)",
  "type": "module",
  "scripts": {
    "start": "npm start --prefix backend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "npm start --prefix backend",
    "client": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
